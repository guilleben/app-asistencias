generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Shift {
  MORNING
  AFTERNOON
}

enum PayFrequency {
  WEEKLY
  MONTHLY
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  dailyRate   Decimal  @db.Decimal(12, 2)
  retroWeekly Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  rates     CategoryRate[]
}

model CategoryRate {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  dailyRate     Decimal  @db.Decimal(12, 2)
  retroWeekly   Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, effectiveFrom])
  @@index([categoryId, effectiveFrom])
}

model Employee {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  categoryId Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  attendances   Attendance[]
  debtMovements DebtMovement[]
  retroactives  Retroactive[]
  aguinaldos    Aguinaldo[]
  payments      Payment[]

  @@index([categoryId])
}

model Site {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date
  shift      Shift
  present    Boolean  @default(true)
  siteId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  site     Site?    @relation(fields: [siteId], references: [id])

  @@unique([employeeId, date, shift])
  @@index([date])
  @@index([siteId])
}

model DebtMovement {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  date       DateTime @default(now())
  paymentId  Int?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  payment  Payment? @relation(fields: [paymentId], references: [id])

  @@index([employeeId])
  @@index([paymentId])
}

model Retroactive {
  id           Int          @id @default(autoincrement())
  employeeId   Int
  month        Int
  year         Int
  frequency    PayFrequency
  weeklyAmount Decimal      @db.Decimal(12, 2)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@index([year, month])
}

model Aguinaldo {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  year         Int
  semester     Int
  totalAmount  Decimal  @db.Decimal(12, 2)
  installments Int
  startDate    DateTime @db.Date
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year, semester])
  @@index([year, semester])
}

model Payment {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  weekStart       DateTime @db.Date
  baseAmount      Decimal  @db.Decimal(12, 2)
  retroAmount     Decimal  @db.Decimal(12, 2)
  aguinaldoAmount Decimal  @db.Decimal(12, 2)
  debtDeduction   Decimal  @db.Decimal(12, 2)
  totalPaid       Decimal  @db.Decimal(12, 2)
  notes           String?
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  employee      Employee       @relation(fields: [employeeId], references: [id])
  debtMovements DebtMovement[]

  @@unique([employeeId, weekStart])
  @@index([weekStart])
}

model Budget {
  id           Int      @id @default(autoincrement())
  owner        String
  workName     String
  location     String
  date         DateTime @db.Date
  totalAmount  Decimal  @db.Decimal(12, 2)
  observations String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items BudgetItem[]

  @@index([date])
}

model BudgetItem {
  id          Int    @id @default(autoincrement())
  budgetId    Int
  description String
  sortOrder   Int    @default(0)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model MaterialList {
  id        Int      @id @default(autoincrement())
  owner     String
  workName  String
  location  String
  date      DateTime @db.Date
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MaterialListItem[]

  @@index([date])
}

model MaterialListItem {
  id             Int          @id @default(autoincrement())
  materialListId Int
  description    String
  quantity       String
  sortOrder      Int          @default(0)

  materialList MaterialList @relation(fields: [materialListId], references: [id], onDelete: Cascade)

  @@index([materialListId])
}
